{
  "name": "@yyc3/music-utils",
  "version": "2.1.0",
  "description": "YYC³ D-Music 基础工具层 — cn / Supabase 客户端 / API / 加密 / 偏好 / 性能注册表 / 监控",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./monitoring": "./src/monitoring.js"
  },
  "scripts": {
    "build": "vite build && cp src/monitoring.js src/monitoring.d.ts dist/ && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.97.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.2.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "fake-indexeddb": "^6.0.1",
    "typescript": "^5.9.2"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./monitoring": "./dist/monitoring.js"
    }
  },
  "keywords": [
    "yyc3",
    "music",
    "utils",
    "supabase"
  ],
  "author": "YYC³ Team <admin@0379.email>",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YYC-Cube/YYC3-MusAI.git",
    "directory": "packages/music-utils"
  },
  "homepage": "https://musai.yyc3.vip",
  "bugs": {
    "url": "https://github.com/YYC-Cube/YYC3-MusAI/issues"
  }
}
