{
  "name": "@yyc3/music-live",
  "version": "1.0.0",
  "description": "YYC³ D-Music 直播组件包 — 直播间 UI / 弹幕渲染 / 礼物动画（对接 music-server /live/ws）",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@yyc3/music-hooks": "workspace:*",
    "@yyc3/music-ui": "workspace:*",
    "@yyc3/music-utils": "workspace:*",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "sonner": "^2.0.8"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "keywords": [
    "yyc3",
    "music",
    "live",
    "danmaku"
  ],
  "author": "YYC³ Team <admin@0379.email>",
  "license": "MIT"
}
