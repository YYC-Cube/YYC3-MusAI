{
  "name": "@yyc3/music-emotion",
  "version": "2.1.0",
  "description": "YYC³ D-Music 情感赋能音效系统 — 小语角色 / 情感类型 / 语音 Hook / 情感映射",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "framer-motion": "^12.0.0",
    "lottie-react": "^2.4.1",
    "styled-components": "^6.1.13"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "keywords": [
    "yyc3",
    "musai",
    "music",
    "emotion",
    "xiaoyu",
