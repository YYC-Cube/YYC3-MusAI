{
  "name": "@yyc3/music-player",
  "version": "2.0.1",
  "description": "YYC³ D-Music 播放器核心组件 — 媒体展示/播放控制/移动端播放器/音频可视化",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slider": "1.2.3",
    "@yyc3/music-hooks": "workspace:*",
    "@yyc3/music-lyrics": "workspace:*",
    "@yyc3/music-ui": "workspace:*",
    "clsx": "2.1.1",
    "hls.js": "^1.7.4",
    "lucide-react": "0.577.0",
    "media-chrome": "^4.19.5",
    "motion": "12.23.24",
    "video.js": "^10.5.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "typescript": "^5.9.2"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "keywords": [
    "yyc3",
