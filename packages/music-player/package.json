{
  "name": "@yyc3/music-player",
  "version": "2.0.0",
  "description": "YYC³ D-Music 播放器核心组件 — 媒体展示/播放控制/移动端播放器/音频可视化",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@radix-ui/react-slider": "1.2.3",
    "@yyc3/music-hooks": "workspace:*",
    "@yyc3/music-lyrics": "workspace:*",
    "@yyc3/music-ui": "workspace:*",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "motion": "12.43.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "keywords": [
    "yyc3",
    "musai",
    "music",
    "player"
  ],
  "author": "YYC³ Team <admin@0379.email>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YYC-Cube/YYC3-MusAI.git",
    "directory": "packages/music-player"
  },
  "homepage": "https://musai.yyc3.vip",
  "bugs": {
    "url": "https://github.com/YYC-Cube/YYC3-MusAI/issues"
  }
