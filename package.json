{
  "name": "yyc3-musai",
  "version": "11.2.0",
  "private": true,
  "description": "YYC³ MusAI — AI 驱动的智能音乐平台（16 包 + 主应用一体化仓库）",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YYC-Cube/YYC3-MusAI.git"
  },
  "homepage": "https://musai.yyc3.vip",
  "bugs": {
    "url": "https://github.com/YYC-Cube/YYC3-MusAI/issues"
  },
  "keywords": [
    "yyc3",
    "musai",
    "yyc3-musai",
    "music",
    "ai-music",
    "music-player",
    "music-generation",
    "audio-visualizer",
    "lyrics",
    "emotion-analysis",
    "react",
    "react19",
    "vite",
    "typescript",
    "monorepo",
    "turborepo",
    "pnpm-workspace",
    "tailwindcss",
    "shadcn-ui",
    "radix-ui",
    "pwa",
    "web-audio",
    "canvas",
    "recharts"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "pnpm --filter @yyc3/d-music exec playwright test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.54.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "turbo": "^2.4.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "7.3.7",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.17.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "turbo"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "react-day-picker@8>react": "19",
        "react-day-picker@8>react-dom": "19"
      }
    }
  }
}
