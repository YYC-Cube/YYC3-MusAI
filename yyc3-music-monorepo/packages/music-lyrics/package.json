{
  "name": "@yyc3/music-lyrics",
  "version": "1.0.0",
  "description": "YYC³ D-Music 歌词组件 — 歌词展示与情感涟漪动效",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@yyc3/music-hooks": "workspace:*",
    "@yyc3/music-utils": "workspace:*",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "motion": "12.43.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "keywords": [
    "yyc3",
    "music",
    "lyrics"
  ],
  "author": "YYC³ Team <admin@0379.email>",
