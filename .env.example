# ================================================================================
# YYC³ MusAI 环境变量模板
# 用法：cp .env.example .env 后按本机 / 节点实际值填写；禁止把真实口令提交进仓库
# 更新：2026-11-17（对齐 OPS 主库迁 NAS + PG17 变阵：45 主库 / 22 只读从库）
# ================================================================================

# ------------------------------------------------------------------------------
# 运行环境
# ------------------------------------------------------------------------------
NODE_ENV=development
ENVIRONMENT=local

# ------------------------------------------------------------------------------
# PostgreSQL 17（主库：yyc3-45 NAS 192.168.3.45:5433，唯一写入口）
# 依据：OPS 台账 docs/YYC3-数据库-执行记录/26-数据库台账-全端资产与连接-2026-11-16.md
#      与 docs/connections.env（连接变量权威源）
# 连接串必须显式带 search_path，禁止依赖默认值
# ------------------------------------------------------------------------------
PG_HOST=192.168.3.45
PG_PORT=5433
PG_USER=musai_app_rw
PG_PASSWORD=
PG_DATABASE=yyc3_music
PG_SCHEMA=musai
PG_SEARCH_PATH=musai,public
PG_POOL_SIZE=20
PG_IDLE_TIMEOUT=30000
PG_CONNECTION_TIMEOUT=10000
PG_SSL_MODE=disable
# 迁移用（仅 Prisma Migrate / 运维脚本使用，应用进程不得加载）
PG_MIGRATION_USER=musai_owner
PG_MIGRATION_PASSWORD=

# ------------------------------------------------------------------------------
# PostgreSQL 17（从库：本机 yyc3-22 127.0.0.1:5433，物理流复制，只读）
# 仅用于只读报表 / 灾备演练；禁止写入，禁止当测试沙箱
# 复制槽：主库侧 mac_standby（22 睡眠多久都不回收 WAL）
# ------------------------------------------------------------------------------
PG_STANDBY_HOST=127.0.0.1
PG_STANDBY_PORT=5433
PG_STANDBY_USER=yanyu
PG_STANDBY_PASSWORD=

# ------------------------------------------------------------------------------
# Redis（缓存 / 会话 / 限流）
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=2
REDIS_SSL=false
REDIS_MAX_CONNECTIONS=50
REDIS_IDLE_TIMEOUT=30000
REDIS_CONNECTION_TIMEOUT=10000
REDIS_CACHE_PREFIX=musai:cache:
REDIS_SESSION_PREFIX=musai:session:
REDIS_AI_RESPONSE_PREFIX=musai:ai:resp:
REDIS_AI_SESSION_PREFIX=musai:ai:session:
REDIS_CACHE_TTL=3600
REDIS_SESSION_TTL=86400
REDIS_AI_RESPONSE_TTL=600
REDIS_AI_SESSION_TTL=1800

# ------------------------------------------------------------------------------
# API 服务（musai-server）
# ------------------------------------------------------------------------------
APP_NAME=YYC3 MusAI
APP_VERSION=11.2.0
APP_PORT=3250
APP_HOST=0.0.0.0
API_BASE_URL=http://localhost:3250
API_PREFIX=/api/v1
# KV 存储驱动：pg（默认，落 musai.kv_store）| supabase（legacy 回退开关）
KV_DRIVER=pg

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=http://localhost:5173
REQUEST_TIMEOUT=30000
REQUEST_MAX_BODY_SIZE=10mb
REQUEST_MAX_FILE_SIZE=50mb
# 本地媒体存储目录（替代 Supabase Storage）
UPLOAD_DIR=./uploads

# ------------------------------------------------------------------------------
# AI 推理接入（Ollama；本地部署走同源代理，远端走直连）
# ------------------------------------------------------------------------------
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_PROXY_PATH=/api/v1/llm/ollama

# ------------------------------------------------------------------------------
# JWT / 鉴权
# ------------------------------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=YYC3-MusAI
JWT_AUDIENCE=musai-users
JWT_ALGORITHM=HS256

# ------------------------------------------------------------------------------
# 邮件（可选）
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=YYC³ MusAI
SMTP_FROM_EMAIL=

# ------------------------------------------------------------------------------
# 日志
# ------------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=console
LOG_FILE_PATH=./logs
LOG_FILE_MAX_SIZE=10m
LOG_FILE_MAX_FILES=7

# ------------------------------------------------------------------------------
# 【LEGACY】Supabase —— 仅服务端 8 个文件仍依赖，P1 迁移完成后删除本段
# 迁移路线：docs/YYC3-MusAI-下一轮主线规划-2026-11-10.md §3
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_PROJECT_ID=

# ------------------------------------------------------------------------------
# 【LEGACY】MySQL —— 历史配置，未接入运行时代码
# ------------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=yyc3_music
MYSQL_USER=
MYSQL_PASSWORD=
