# ================================================================================
# YYC³ MusAI Server · NAS 生产变量（/Volume3/docker/yyc3-musai-server/musai-server.env）
#
# 拓扑（对齐 OPS 台账 26 号 / connections.env）：
#   主库 = yyc3-45 NAS 192.168.3.45:5433（PG17.11 @V3 NVMe，唯一写入口）
#   从库 = yyc3-22 本机 127.0.0.1:5433（只读，禁止作为应用写库）
# 账号：musai_app_rw（scram-sha-256），口令权威源 = api-keys.env MUSAI_APP_RW_PASSWORD
# ================================================================================

NODE_ENV=production
ENVIRONMENT=production
APP_NAME=YYC³ MusAI
APP_VERSION=11.2.0

# host 网络下直接监听 3250
PORT=3250
HOST=0.0.0.0

KV_DRIVER=pg

PG_HOST=192.168.3.45
PG_PORT=5433
PG_USER=musai_app_rw
PG_PASSWORD=
PG_DATABASE=yyc3_music
PG_IDLE_TIMEOUT=30000
PG_CONNECTION_TIMEOUT=10000

# 本地媒体存储目录（替代 Supabase Storage；compose 已固定挂载 /app/uploads）
UPLOAD_DIR=/app/uploads
# 对外媒体地址前缀
PUBLIC_BASE_URL=https://musai.yyc3.vip
# /metrics 抓取令牌（建议设置强随机值）
METRICS_TOKEN=
# WebSocket 是否允许匿名（0=必须 ?token=JWT）
WS_ALLOW_ANONYMOUS=0

# 1 = 跳过关系表读写（仅排障时使用）
DB_DISABLED=0

# 【LEGACY】仅 space-time 语音等存量端点依赖；其余已切应用层 JWT + PG
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

CORS_ORIGIN=https://musai.yyc3.vip
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# 本地/局域网 OpenAI 兼容推理（vLLM / NVIDIA Sync Model Launcher）
# baseUrl 必须带 /v1；模型留空则自动从 /v1/models 解析
# 模型端点可达后再填写，例如 http://192.168.3.50:8000/v1
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_MODEL=

# 自托管 STT（OpenAI 兼容 /v1/audio/transcriptions）
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1
