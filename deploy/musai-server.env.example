# ================================================================================
# YYC³ MusAI Server —— 生产环境变量模板
#
# 用法：cp deploy/musai-server.env.example deploy/musai-server.env 后填写真实值
# 禁止把真实口令提交进仓库（deploy/.gitignore 已忽略 musai-server.env）
# ================================================================================

NODE_ENV=production
ENVIRONMENT=production
APP_NAME=YYC³ MusAI
APP_VERSION=11.2.0

# 进程监听（容器内固定 8080，宿主机端口由 MUSAI_PORT 控制）
PORT=8080
HOST=0.0.0.0

# KV 驱动：pg（落 musai.kv_store）| supabase（legacy 回退）
KV_DRIVER=pg

# ------------------------------------------------------------------------------
# 鉴权（W8-P0-2 必需：缺失 JWT_SECRET 服务启动即退出）
# 生成：openssl rand -hex 32
# ------------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 上传（本地卷 + 对外可访问基址；卷需持久化挂载）
UPLOAD_DIR=/app/uploads
PUBLIC_BASE_URL=https://musai.yyc3.vip

# WS 允许匿名连接（生产建议留空=强制 token）
WS_ALLOW_ANONYMOUS=


# ------------------------------------------------------------------------------
# PostgreSQL 15（主库；容器内访问宿主机需改为 host.docker.internal 或桥接网关）
# ------------------------------------------------------------------------------
PG_HOST=host.docker.internal
PG_PORT=5433
PG_USER=musai_app_rw
PG_PASSWORD=
PG_DATABASE=yyc3_music
PG_IDLE_TIMEOUT=30000
PG_CONNECTION_TIMEOUT=10000

# 关系表灰度开关：1 = 跳过全部关系表读写（仅 KV 提供服务）
DB_DISABLED=0

# ------------------------------------------------------------------------------
# 【LEGACY】Supabase —— 仅 /signup、space-time 语音等存量端点依赖
# 登录/会话签发端点补齐后可整段移除
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# CORS / 限流
# ------------------------------------------------------------------------------
CORS_ORIGIN=https://musai.yyc3.vip
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
