# ================================================================================
# YYC³ API 代理网关 - 环境变量配置示例
# ================================================================================
#
# > YanYuCloudCube
# > 言启象限 | 语枢未来
# > Words Initiate Quadrants, Language Serves as Core for Future
#
# 使用说明:
# 1. 复制此文件为 .env.api-proxy: cp .env.api-proxy.example .env.api-proxy
# 2. 填写实际的 API 密钥
# 3. 将 .env.api-proxy 添加到 .gitignore
# 4. 在代码中加载这些环境变量
#
# ================================================================================

# API 代理网关基础配置
API_PROXY_BASE_URL=https://api.0379.world
API_PROXY_TIMEOUT=300000

# ================================================================================
# 智谱 AI (Zhipu AI)
# ================================================================================
# 获取 API 密钥: https://open.bigmodel.cn/
# 文档: https://open.bigmodel.cn/dev/api

ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_API_BASE_URL=https://api.0379.world/api/proxy/zhipu

# 智谱 AI 模型配置
ZHIPU_DEFAULT_MODEL=glm-4
ZHIPU_MAX_TOKENS=4000
ZHIPU_TEMPERATURE=0.7

# ================================================================================
# DeepSeek
# ================================================================================
# 获取 API 密钥: https://platform.deepseek.com/
# 文档: https://platform.deepseek.com/docs/

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE_URL=https://api.0379.world/api/proxy/deepseek

# DeepSeek 模型配置
DEEPSEEK_DEFAULT_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=4000
DEEPSEEK_TEMPERATURE=0.7

# ================================================================================
# OpenAI
# ================================================================================
# 获取 API 密钥: https://platform.openai.com/
# 文档: https://platform.openai.com/docs/

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE_URL=https://api.0379.world/api/proxy/openai

# OpenAI 模型配置
OPENAI_DEFAULT_MODEL=gpt-4
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7

# ================================================================================
# 通义千问 (Qwen)
# ================================================================================
# 获取 API 密钥: https://dashscope.aliyun.com/
# 文档: https://help.aliyun.com/zh/dashscope/

QWEN_API_KEY=your_qwen_api_key_here
QWEN_API_BASE_URL=https://api.0379.world/api/proxy/qwen

# 通义千问模型配置
QWEN_DEFAULT_MODEL=qwen-max
QWEN_MAX_TOKENS=4000
QWEN_TEMPERATURE=0.7

# ================================================================================
# 应用配置
# ================================================================================

# 默认 AI 服务提供商 (zhipu | deepseek | openai | qwen)
DEFAULT_AI_PROVIDER=zhipu

# 请求配置
REQUEST_TIMEOUT=30000
RETRY_COUNT=3
RETRY_DELAY=1000

# 日志配置
LOG_LEVEL=info
LOG_API_CALLS=true
LOG_ERRORS=true

# ================================================================================
# 开发环境配置
# ================================================================================

# 是否启用调试模式
DEBUG=false

# 是否使用模拟响应（开发测试用）
USE_MOCK_RESPONSE=false

# Mock 延迟时间（毫秒）
MOCK_DELAY=1000

# ================================================================================
# 安全配置
# ================================================================================

# API 密钥加密（如需要）
ENCRYPT_API_KEYS=false

# IP 白名单（逗号分隔，留空则不限制）
ALLOWED_IPS=

# 请求频率限制（每分钟请求数）
RATE_LIMIT_PER_MINUTE=60

# ================================================================================
# 配置说明
# ================================================================================
#
# 1. 复制此文件:
#    cp .env.api-proxy.example .env.api-proxy
#
# 2. 填写 API 密钥:
#    将 your_xxx_api_key_here 替换为实际的 API 密钥
#
# 3. 加载环境变量:
#
#    Node.js:
#    require('dotenv').config({ path: '.env.api-proxy' })
#
#    Python:
#    from dotenv import load_dotenv
#    load_dotenv('.env.api-proxy')
#
#    Go:
#    godotenv.Load(".env.api-proxy")
#
# 4. 使用环境变量:
#    const apiKey = process.env.ZHIPU_API_KEY
#    const baseUrl = process.env.API_PROXY_BASE_URL
#
# ================================================================================
